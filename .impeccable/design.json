  "narrative": {
    "northStar": "A working sheet beside a quiet frame",
    "overview": "Synapse keeps the user-confirmed sage and ink identity. A pale frame contains navigation and a white sheet carries the work. The interface is compact and restrained, while Lora gives sustained note writing a slower reading rhythm. Inter keeps controls and graph relationships easy to scan.\n\nThis records the implemented system in `src/styles.css`, sampled against `Graph.tsx`, `RichEditor.tsx`, `NoteView.tsx`, `editorNodes.tsx`, and `diagramDesign.ts`. It preserves an existing identity rather than proposing a new visual world. The independently chosen Diagram Design editorial treatment belongs to generated diagrams, not the surrounding notebook interface.",
    "keyCharacteristics": [
      "Sage selection and deep ink text.",
      "A white working sheet within a pale frame.",
      "Inter controls paired with Lora note typography.",
      "Quiet containers, visible relationships, and contextual editing tools.",
      "A separate editorial palette for generated diagrams."
    ],
    "rules": [
      {
        "name": "The Separate Diagram World Rule",
        "body": "Use the editorial palette inside generated diagrams; keep sage and ink for notebook chrome.",
        "section": "colors"
      },
      {
        "name": "The Two Reading Speeds Rule",
        "body": "Keep sustained writing in Lora and task controls and graph relationships in Inter.",
        "section": "typography"
      },
      {
        "name": "The Quiet Surface Rule",
        "body": "Keep working surfaces flat; reserve visible elevation for overlays.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve the confirmed sage and ink identity and Inter/Lora pairing.",
      "Do use semantic ink, surface, line, and muted variables for theme-aware graph text.",
      "Do preserve a white reading sheet and quiet contextual controls.",
      "Do pair status color with explicit text.",
      "Do keep generated diagram styling separate from application chrome.",
      "Do verify responsive layouts against the final cascade and the rendered surface."
    ],
    "donts": [
      "Don't replace the existing identity during ordinary refinement.",
      "Don't turn graph-specific composition into a global layout requirement.",
      "Don't give flat working cards decorative elevation.",
      "Don't use em dashes in interface copy, generated text, or documentation."
    ]
  }
}
