{
  "name": "synapse-local",
  "productName": "Synapse",
  "description": "A local-first study notebook with an intentional knowledge graph.",
  "author": "Dhanusha Ravinda",
  "private": true,
  "version": "1.4.0",
  "type": "module",
  "main": "desktop-dist/main.mjs",
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts --production",
    "test": "vitest run",
    "check": "tsc --noEmit",
    "desktop:compile": "esbuild desktop/main.ts --bundle --platform=node --format=esm --target=node22 --packages=external --external:electron --external:electron-updater --outfile=desktop-dist/main.mjs && esbuild desktop/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=desktop-dist/preload.cjs",
    "desktop:stage": "node scripts/stage-desktop.mjs",
    "desktop:publish": "node scripts/publish-desktop.mjs",
    "desktop:unpacked": "npm run build && npm run desktop:compile && npm run desktop:stage && electron-builder --win nsis --dir",
    "desktop:installer": "npm run build && npm run desktop:compile && npm run desktop:stage && electron-builder --win nsis",
    "postinstall": "node scripts/prepare-assets.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.3",
    "@excalidraw/excalidraw": "^0.18.1",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@fontsource/geist": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@mozilla/readability": "^0.6.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-task-item": "^3.32.0",
    "@tiptap/extension-task-list": "^3.32.0",
    "@tiptap/markdown": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@xyflow/react": "^12.12.0",
    "electron-updater": "^6.8.11",
    "express": "^5.3.0",
    "gray-matter": "^4.0.3",
    "jsdom": "^30.1.3",
    "lucide-react": "^1.61.0",
    "multer": "^2.5.0",
    "openai": "^7.44.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/dagre": "^0.7.54",
    "@types/express": "^5.0.6",
    "@types/jsdom": "^30.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "nanoid": "^5.1.16",
    "lodash-es": "^4.18.1",
    "katex": "^0.19.1"
  },
  "build": {
    "appId": "com.dhanusharavinda.synapse",
    "productName": "Synapse",
    "asar": true,
    "asarUnpack": [
      "node_modules/@ffmpeg-installer/**/*",
      "node_modules/tesseract.js/**/*",
      "node_modules/tesseract.js-core/**/*",
      "node_modules/@tesseract.js-data/**/*",
      "node_modules/regenerator-runtime/**/*",
      "node_modules/bmp-js/**/*",
      "node_modules/is-url/**/*",
      "node_modules/wasm-feature-detect/**/*",
      "node_modules/node-fetch/**/*",
      "node_modules/zlibjs/**/*"
    ],
    "directories": {
      "app": "desktop-stage",
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "desktop-dist/**/*",
      "build/icon.png",
      "package.json",
      "!**/*.map",
      "!node_modules/**/{test,tests,__tests__,docs,examples}/**/*",
      "!node_modules/tesseract.js-core/*.wasm.js",
      "!node_modules/@tesseract.js-data/eng/4.0.0_best_int/**/*"
    ],
    "electronLanguages": [
      "en-US",
      "en-GB"
    ],
    "compression": "maximum",
    "extraResources": [
      {
        "from": "scripts/hermes_speech.py",
        "to": "scripts/hermes_speech.py"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "artifactName": "Synapse-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": {
      "provider": "github",
      "owner": "dhanusharavinda",
      "repo": "PROJECT_SYNAPSE_AINOTES"
    }
  }
}
